<mvc:View
    controllerName="yegeoaiso.controller.DataAcquisition"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">

    <Page
        id="dataAcquisitionPage"
        title="数据获取"
        showNavButton="true"
        navButtonPress="onNavBack"
        backgroundDesign="Transparent">

        <content>
            <!-- Customer Selection -->
            <Panel
                expandable="true"
                expanded="true"
                headerText="客户选择"
                width="auto"
                class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar style="Clear">
                        <Title text="选择客户"/>
                        <ToolbarSpacer/>
                        <core:Icon src="sap-icon://customer" class="sapUiTinyMarginEnd"/>
                    </Toolbar>
                </headerToolbar>
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Label text="客户" required="true" class="sapUiTinyMarginBottom"/>
                        <HBox alignItems="Center">
                            <ComboBox
                                id="customerSelect"
                                selectedKey="{dataAcquisition>/selectedCustomer}"
                                selectionChange="onCustomerChange"
                                width="400px"
                                placeholder="请选择客户..."
                                showSecondaryValues="true"
                                class="sapUiTinyMarginEnd">
                                <core:ListItem key="customerA" text="客户A" additionalText="高级合作伙伴" icon="sap-icon://customer"/>
                                <core:ListItem key="customerB" text="客户B" additionalText="标准合作伙伴" icon="sap-icon://customer"/>
                            </ComboBox>
                            <MessageStrip
                                id="customerInfoStrip"
                                text="请选择客户以自动配置数据源"
                                type="Information"
                                showIcon="true"
                                visible="{= !${dataAcquisition>/selectedCustomer}}"/>
                            <MessageStrip
                                text="客户A - 链接已自动配置"
                                type="Success"
                                showIcon="true"
                                visible="{= ${dataAcquisition>/selectedCustomer} === 'customerA'}"/>
                            <MessageStrip
                                text="客户B - 准备配置"
                                type="Success"
                                showIcon="true"
                                visible="{= ${dataAcquisition>/selectedCustomer} === 'customerB'}"/>
                        </HBox>
                    </VBox>
                </content>
            </Panel>

            <!-- Data Type Selection -->
            <Panel
                expandable="true"
                expanded="true"
                headerText="数据源选择"
                width="auto"
                class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar style="Clear">
                        <Title text="选择数据源类型"/>
                        <ToolbarSpacer/>
                        <core:Icon src="sap-icon://database" class="sapUiTinyMarginEnd"/>
                    </Toolbar>
                </headerToolbar>
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Label text="数据类型" required="true" class="sapUiTinyMarginBottom"/>
                        <SegmentedButton
                            id="dataTypeSegmented"
                            selectedKey="{dataAcquisition>/dataType}"
                            selectionChange="onDataTypeChange"
                            class="sapUiSmallMarginBottom">
                            <items>
                                <SegmentedButtonItem key="structured" icon="sap-icon://internet-browser" text="结构化数据（网页）"/>
                                <SegmentedButtonItem key="unstructured" icon="sap-icon://document" text="非结构化数据（PDF/文档）"/>
                            </items>
                        </SegmentedButton>
                    </VBox>
                </content>
            </Panel>

            <!-- Structured Data Input (Web Scraping) -->
            <Panel
                id="structuredDataPanel"
                expandable="true"
                expanded="true"
                headerText="结构化数据配置"
                visible="{= ${dataAcquisition>/dataType} === 'structured'}"
                width="auto"
                class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar style="Clear">
                        <Title text="自动从Excel下载数据"/>
                        <ToolbarSpacer/>
                        <core:Icon src="sap-icon://globe" class="sapUiTinyMarginEnd"/>
                    </Toolbar>
                </headerToolbar>
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Label text="网站链接" required="true"/>
                        <Input
                            id="websiteUrl"
                            value="{dataAcquisition>/websiteUrl}"
                            width="100%"
                            enabled="false"
                            class="sapUiSmallMarginBottom"/>

                        <Button
                            id="downloadButton"
                            text="下载Excel文件"
                            type="Emphasized"
                            icon="sap-icon://download"
                            press="onDownloadExcel"
                            enabled="{= !${dataAcquisition>/downloadSuccess}}"
                            width="200px"
                            class="sapUiSmallMarginBottom"/>

                        <MessageStrip
                            id="downloadStatus"
                            visible="{= ${dataAcquisition>/downloadStatus} !== ''}"
                            text="{dataAcquisition>/downloadStatus}"
                            type="{= ${dataAcquisition>/isDownloading} ? 'Information' : 
                                ${dataAcquisition>/downloadSuccess} ? 'Success' : 'Error'}"
                            showIcon="true">
                            <customData>
                                <core:CustomData 
                                    key="showLoadingIndicator" 
                                    value="{dataAcquisition>/isDownloading}"/>
                            </customData>
                        </MessageStrip>
                    </VBox>
                </content>
