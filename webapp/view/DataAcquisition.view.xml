            </form:content>
                    </form:SimpleForm>
                </content> -->
            </Panel>

            <!-- Unstructured Data Input (Document AI Integration) -->
            <Panel
                id="unstructuredDataPanel"
                expandable="true"
                expanded="true"
                headerText="Document AI处理"
                visible="{= ${dataAcquisition>/dataType} === 'unstructured'}"
                width="auto"
                class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar style="Clear">
                        <Title text="SAP Document AI"/>
                        <ToolbarSpacer/>
                        <core:Icon src="sap-icon://BusinessSuiteInAppSymbols/icon-ai" class="sapUiTinyMarginEnd"/>
                    </Toolbar>
                </headerToolbar>
                <content>
                    <VBox class="sapUiSmallMargin">
                        <!-- 说明信息 -->
                        <MessageStrip
                            text="请使用SAP Document AI应用程序处理您的文档。点击下方按钮打开Document AI。"
                            type="Information"
                            showIcon="true"
                            class="sapUiSmallMarginBottom"/>

                        <!-- 跳转到 Document AI 按钮 -->
                        <VBox class="sapUiSmallMarginTop">
                            <Label text="步骤1：处理文档" class="sapUiTinyMarginBottom"/>
                            <Button
                                id="openDocumentAIButton"
                                text="打开Document AI"
                                type="Emphasized"
                                icon="sap-icon://BusinessSuiteInAppSymbols/icon-ai"
                                press="onOpenDocumentAI"
                                width="250px"
                                class="sapUiSmallMarginBottom"/>
                            <Text 
                                text="这将在新窗口中打开SAP Document AI应用程序。请在那里处理您的文档，完成后返回此页面。"
                                class="sapUiTinyText"/>
                        </VBox>

                        <!-- 数据下载确认 -->
                        <VBox class="sapUiMediumMarginTop">
                            <Label text="步骤2：确认数据下载" class="sapUiTinyMarginBottom"/>
                            <MessageStrip
                                id="documentAIStatusStrip"
                                text="{dataAcquisition>/documentAIStatus}"
                                type="{dataAcquisition>/documentAIStatusType}"
                                showIcon="true"
                                visible="{= ${dataAcquisition>/documentAIStatus} !== ''}"
                                class="sapUiSmallMarginBottom"/>
                            
                            <HBox alignItems="Center" class="sapUiSmallMarginTop">
                                <Button
                                    id="confirmDataDownloadButton"
                                    text="确认已从Document AI下载数据"
                                    type="Accept"
                                    icon="sap-icon://accept"
                                    press="onConfirmDocumentAIData"
                                    width="350px"
                                    enabled="{= !${dataAcquisition>/documentAIDataConfirmed}}"/>
                            </HBox>
                            
                            <!-- 确认成功提示 -->
                            <MessageStrip
                                visible="{dataAcquisition>/documentAIDataConfirmed}"
                                text="✓ 已成功从Document AI应用程序下载数据。现在可以进行下一步操作。"
                                type="Success"
                                showIcon="true"
                                class="sapUiSmallMarginTop"/>
                        </VBox>
                    </VBox>
                </content>
            </Panel>

            <!-- Extraction Results Preview -->
