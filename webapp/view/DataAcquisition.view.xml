            <!-- Unstructured Data Input (PDF/Document Upload) -->
            <Panel
                id="unstructuredDataPanel"
                expandable="true"
                expanded="true"
                headerText="Unstructured Data Upload"
                visible="{= ${dataAcquisition>/dataType} === 'unstructured'}"
                width="auto"
                class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar style="Clear">
                        <Title text="Document Data Extraction"/>
                        <ToolbarSpacer/>
                        <core:Icon src="sap-icon://pdf-attachment" class="sapUiTinyMarginEnd"/>
                    </Toolbar>
                </headerToolbar>
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Label text="Upload Document" required="true" class="sapUiTinyMarginBottom"/>
                        <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                            <u:FileUploader
                                id="documentUploader"
                                buttonText="Choose Document"
                                fileType="pdf,doc,docx,txt"
                                change="onDocumentSelect"
                                style="Emphasized"
                                useMultipart="false"
                                sendXHR="true"/>
                            <MessageStrip
                                id="documentNameStrip"
                                text="No document selected"
                                type="Information"
                                showIcon="true"
                                class="sapUiTinyMarginBegin"/>
                        </HBox>

