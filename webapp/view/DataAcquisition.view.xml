            </Panel>

            <!-- Unstructured Data Input (Document AI Integration) -->
            <Panel
                id="unstructuredDataPanel"
                expandable="true"
                expanded="true"
                headerText="Document AI Processing"
                visible="{= ${dataAcquisition>/dataType} === 'unstructured'}"
                width="auto"
                class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar style="Clear">
                        <Title text="SAP Document AI"/>
                        <ToolbarSpacer/>
                        <core:Icon src="sap-icon://BusinessSuiteInAppSymbols/icon-ai" class="sapUiTinyMarginEnd"/>
                    </Toolbar>
                </headerToolbar>
                <content>
                    <VBox class="sapUiSmallMargin">
                        <!-- 说明信息 -->
                        <MessageStrip
                            text="Please process your documents using SAP Document AI application. Click the button below to open Document AI."
                            type="Information"
                            showIcon="true"
                            class="sapUiSmallMarginBottom"/>

                        <!-- 跳转到 Document AI 按钮 -->
                        <VBox class="sapUiSmallMarginTop">
                            <Label text="Step 1: Process Documents" class="sapUiTinyMarginBottom"/>
                            <Button
                                id="openDocumentAIButton"
                                text="Open SAP Document AI"
                                type="Emphasized"
                                icon="sap-icon://BusinessSuiteInAppSymbols/icon-ai"
                                press="onOpenDocumentAI"
                                width="250px"
                                class="sapUiSmallMarginBottom"/>
                            <Text 
                                text="This will open the SAP Document AI application in a new window. Process your documents there and return to this page when complete."
                                class="sapUiTinyText"/>
                        </VBox>

                        <!-- 数据下载确认 -->
                        <VBox class="sapUiMediumMarginTop">
                            <Label text="Step 2: Confirm Data Download" class="sapUiTinyMarginBottom"/>
                            <MessageStrip
                                id="documentAIStatusStrip"
                                text="{dataAcquisition>/documentAIStatus}"
                                type="{dataAcquisition>/documentAIStatusType}"
                                showIcon="true"
                                visible="{= ${dataAcquisition>/documentAIStatus} !== ''}"
                                class="sapUiSmallMarginBottom"/>
                            
                            <HBox alignItems="Center" class="sapUiSmallMarginTop">
                                <Button
                                    id="confirmDataDownloadButton"
                                    text="Confirm Data Downloaded from Document AI"
                                    type="Accept"
                                    icon="sap-icon://accept"
                                    press="onConfirmDocumentAIData"
                                    width="350px"
                                    enabled="{= !${dataAcquisition>/documentAIDataConfirmed}}"/>
                            </HBox>
                            
                            <!-- 确认成功提示 -->
                            <MessageStrip
                                visible="{dataAcquisition>/documentAIDataConfirmed}"
                                text="✓ Data has been successfully downloaded from Document AI application. You can now proceed to the next step."
                                type="Success"
                                showIcon="true"
                                class="sapUiSmallMarginTop"/>
                        </VBox>
                    </VBox>
                </content>
            </Panel>

            <!-- Extraction Results Preview -->
