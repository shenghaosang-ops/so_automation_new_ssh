<mvc:View
    controllerName="yegeoaiso.controller.DataAcquisition"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:u="sap.ui.unified"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
    xmlns:html="http://www.w3.org/1999/xhtml"
    xmlns:form="sap.ui.layout.form">

    <Page
        id="dataAcquisitionPage"
        title="Data Acquisition"
        showNavButton="true"
        navButtonPress="onNavBack"
        backgroundDesign="Transparent">

        <content>
            <!-- Customer Selection -->
            <Panel
                expandable="true"
                expanded="true"
                headerText="Customer Selection"
                width="auto"
                class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar style="Clear">
                        <Title text="Select Customer"/>
                        <ToolbarSpacer/>
                        <core:Icon src="sap-icon://customer" class="sapUiTinyMarginEnd"/>
                    </Toolbar>
                </headerToolbar>
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Label text="Customer" required="true" class="sapUiTinyMarginBottom"/>
                        <HBox alignItems="Center">
                            <ComboBox
                                id="customerSelect"
                                selectedKey="{dataAcquisition>/selectedCustomer}"
                                selectionChange="onCustomerChange"
                                width="400px"
                                placeholder="Select a customer..."
                                showSecondaryValues="true"
                                class="sapUiTinyMarginEnd">
                                <core:ListItem key="customerA" text="Customer A" additionalText="Premium Partner" icon="sap-icon://customer"/>
                                <core:ListItem key="customerB" text="Customer B" additionalText="Standard Partner" icon="sap-icon://customer"/>
                            </ComboBox>
                            <MessageStrip
                                id="customerInfoStrip"
                                text="Please select a customer to auto-configure data source"
                                type="Information"
                                showIcon="true"
                                visible="{= !${dataAcquisition>/selectedCustomer}}"/>
                            <MessageStrip
                                text="Customer A - URL auto-configured"
                                type="Success"
                                showIcon="true"
                                visible="{= ${dataAcquisition>/selectedCustomer} === 'customerA'}"/>
                            <MessageStrip
                                text="Customer B - Ready for configuration"
                                type="Success"
                                showIcon="true"
                                visible="{= ${dataAcquisition>/selectedCustomer} === 'customerB'}"/>
                        </HBox>
                    </VBox>
                </content>
            </Panel>

            <!-- Data Type Selection -->
            <Panel
                expandable="true"
                expanded="true"
                headerText="Data Source Selection"
                width="auto"
                class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar style="Clear">
                        <Title text="Select Data Source Type"/>
                        <ToolbarSpacer/>
                        <core:Icon src="sap-icon://database" class="sapUiTinyMarginEnd"/>
                    </Toolbar>
                </headerToolbar>
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Label text="Data Type" required="true" class="sapUiTinyMarginBottom"/>
                        <SegmentedButton
                            id="dataTypeSegmented"
                            selectedKey="{dataAcquisition>/dataType}"
                            selectionChange="onDataTypeChange"
                            class="sapUiSmallMarginBottom">
                            <items>
                                <SegmentedButtonItem key="structured" icon="sap-icon://internet-browser" text="Structured Data (Web)"/>
                                <SegmentedButtonItem key="unstructured" icon="sap-icon://document" text="Unstructured Data (PDF/Document)"/>
                            </items>
                        </SegmentedButton>
                    </VBox>
                </content>
            </Panel>

            <!-- Structured Data Input (Web Scraping) -->
            <Panel
                id="structuredDataPanel"
                expandable="true"
                expanded="true"
                headerText="Structured Data Configuration"
                visible="{= ${dataAcquisition>/dataType} === 'structured'}"
                width="auto"
                class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar style="Clear">
                        <Title text="Automatic Download Data from Excel"/>
                        <ToolbarSpacer/>
                        <core:Icon src="sap-icon://globe" class="sapUiTinyMarginEnd"/>
                    </Toolbar>
                </headerToolbar>
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Label text="Website URL" required="true"/>
                        <Input
                            id="websiteUrl"
                            value="{dataAcquisition>/websiteUrl}"
                            width="100%"
                            enabled="false"
                            class="sapUiSmallMarginBottom"/>

                        <Button
                            id="downloadButton"
                            text="Download Excel File"
                            type="Emphasized"
                            icon="sap-icon://download"
                            press="onDownloadExcel"
                            enabled="{= !${dataAcquisition>/downloadSuccess}}"
                            width="200px"
                            class="sapUiSmallMarginBottom"/>

                        <MessageStrip
                            id="downloadStatus"
                            visible="{= ${dataAcquisition>/downloadStatus} !== ''}"
                            text="{dataAcquisition>/downloadStatus}"
                            type="{= ${dataAcquisition>/downloadSuccess} ? 'Success' : 'Error'}"
                            showIcon="true"/>
                    </VBox>
                </content>
