                    </VBox>
                </content>
            </Panel> -->
        </content>

        <footer>
            <Toolbar>
                <ToolbarSpacer/>
                <Button
                    text="Next: SO Processing"
                    type="Emphasized"
                    icon="sap-icon://navigation-right-arrow"
                    iconDensityAware="false"
                    press="onNavigateToSOAutomation"
                    enabled="{= (${dataAcquisition>/dataType} === 'structured' &amp;&amp; ${dataAcquisition>/downloadSuccess}) || (${dataAcquisition>/dataType} === 'unstructured' &amp;&amp; ${dataAcquisition>/documentAIDataConfirmed})}"/>
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
