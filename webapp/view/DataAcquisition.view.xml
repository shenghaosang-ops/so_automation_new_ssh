                                                <Button
                                                    text="0% - 51%"
                                                    type="Reject"
                                                    press="onFilterConfidence"
                                                    class="sapUiTinyMarginEnd"/>
                                                    <customData>
                                                        <core:CustomData key="range" value="low"/>
                                                    </customData>
                                                <Button
                                                    text="51% - 80%"
                                                    type="Attention"
                                                    press="onFilterConfidence"
                                                    class="sapUiTinyMarginEnd"/>
                                                    <customData>
                                                        <core:CustomData key="range" value="medium"/>
                                                    </customData>
