<mvc:View
    controllerName="yegeoaiso.controller.SOUpload"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">

    <Page
        id="soUploadPage"
        title="销售订单上传至ERP"
        showNavButton="true"
        navButtonPress="onNavBack"
        backgroundDesign="Transparent">

        <content>
            <!-- Upload Summary -->
            <Panel
                expandable="true"
                expanded="true"
                headerText="上传摘要"
                width="auto"
                class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar style="Clear">
                        <Title text="销售订单数据摘要"/>
                        <ToolbarSpacer/>
                        <core:Icon src="sap-icon://information" class="sapUiTinyMarginEnd"/>
                    </Toolbar>
                </headerToolbar>
                <content>
                    <l:HorizontalLayout class="sapUiSmallMargin">
                        <l:VerticalLayout width="200px" class="sapUiSmallMarginEnd">
                            <ObjectStatus
                                title="记录总数"
                                text="{soUpload>/totalRecords}"
                                state="Information"
                                icon="sap-icon://documents"/>
                        </l:VerticalLayout>
                        <l:VerticalLayout width="200px" class="sapUiSmallMarginEnd">
                            <ObjectStatus
                                title="Valid记录"
                                text="{soUpload>/validRecords}"
                                state="Success"
                                icon="sap-icon://status-positive"/>
                        </l:VerticalLayout>
                        <l:VerticalLayout width="200px">
                            <ObjectStatus
                                title="Invalid记录"
                                text="{soUpload>/invalidRecords}"
                                state="Warning"
                                icon="sap-icon://status-error"/>
                        </l:VerticalLayout>
                    </l:HorizontalLayout>
                </content>
            </Panel>

            <!-- SO Data Table -->
            <Panel
                expandable="true"
                expanded="true"
                headerText="待上传销售订单数据"
                width="auto"
                class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar style="Clear">
                        <Title text="审核销售订单数据"/>
                        <ToolbarSpacer/>
                        <SearchField 
                            width="15rem" 
                            placeholder="搜索..." 
                            search="onSearchData"/>
                        <core:Icon src="sap-icon://table-view" class="sapUiTinyMarginEnd"/>
                    </Toolbar>
                </headerToolbar>
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Table
                            id="soDataTable"
                            items="{soUpload>/soData}"
                            sticky="ColumnHeaders"
                            growing="true"
                            growingThreshold="50"
                            mode="MultiSelect">
                            <columns>
                                <Column width="60px"><Text text="行号"/></Column>
                                <Column width="80px"><Text text="状态"/></Column>
                                <Column><Text text="客户代码"/></Column>
                                <Column><Text text="采购订单号"/></Column>
                                <Column><Text text="采购订单日期"/></Column>
                                <Column><Text text="行项目"/></Column>
                                <Column><Text text="物料编号"/></Column>
                                <Column><Text text="数量"/></Column>
                                <Column><Text text="需求日期"/></Column>
                                <Column><Text text="销售订单类型"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{soUpload>rowIndex}"/>
                                        <ObjectStatus
                                            text="{= ${soUpload>valid} ? 'Valid' : 'Invalid'}"
                                            state="{= ${soUpload>valid} ? 'Success' : 'Warning'}"
                                            icon="{= ${soUpload>valid} ? 'sap-icon://accept' : 'sap-icon://alert'}"/>
                                        <Text text="{soUpload>customerCode}"/>
                                        <Text text="{soUpload>poNumber}"/>
                                        <Text text="{soUpload>poDate}"/>
                                        <Text text="{soUpload>itemNo}"/>
                                        <Text text="{soUpload>partNo}"/>
                                        <Text text="{soUpload>quantity}"/>
                                        <Text text="{soUpload>requestDate}"/>
                                        <Text text="{soUpload>salesOrderType}"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </content>
            </Panel>

            <!-- Validation & Upload Actions -->
            <Panel
                expandable="true"
                expanded="true"
                headerText="上传操作"
                width="auto"
                class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar style="Clear">
                        <Title text="校验与上传"/>
                        <ToolbarSpacer/>
                        <core:Icon src="sap-icon://action" class="sapUiTinyMarginEnd"/>
                    </Toolbar>
                </headerToolbar>
                <content>
                    <VBox class="sapUiSmallMargin">
                        <HBox justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                            <VBox width="60%">
                                <Label text="ERP系统配置" class="sapUiTinyMarginBottom"/>
                                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                    <Label text="系统：" width="100px"/>
                                    <Input 
                                        value="{soUpload>/erpSystem}" 
                                        placeholder="SAP S/4HANA"
                                        width="300px"/>
                                </HBox>
                                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                    <Label text="连接状态：" width="100px"/>
                                    <ObjectStatus
                                        text="{= ${soUpload>/connectionStatus} === 'Connected' ? 'Connected' : 'Disconnected'}"
                                        state="{= ${soUpload>/connectionStatus} === 'Connected' ? 'Success' : 'Error'}"
                                        icon="{= ${soUpload>/connectionStatus} === 'Connected' ? 'sap-icon://connected' : 'sap-icon://disconnected'}"/>
                                </HBox>
                            </VBox>
                            <VBox width="35%">
                                <Button
                                    text="Check Data Validity"
                                    type="Transparent"
                                    icon="sap-icon://inspect"
                                    press="onCheckData"
                                    width="100%"
                                    class="sapUiTinyMarginBottom"/>
                                <Button
                                    text="执行上传至ERP"
                                    type="Emphasized"
                                    icon="sap-icon://upload-to-cloud"
                                    press="onExecuteUpload"
                                    enabled="{= ${soUpload>/validRecords} > 0}"
                                    width="100%"/>
                            </VBox>
                        </HBox>

                        <!-- Upload Progress -->
                        <VBox 
                            visible="{= ${soUpload>/uploadInProgress} === true}"
                            class="sapUiSmallMarginTop">
                            <Label text="上传进度" class="sapUiTinyMarginBottom"/>
                            <ProgressIndicator
                                percentValue="{soUpload>/uploadProgress}"
                                displayValue="{soUpload>/uploadProgress}%"
                                showValue="true"
                                state="{= ${soUpload>/uploadProgress} === 100 ? 'Success' : 'Information'}"/>
                            <Text 
                                text="已上传 {soUpload>/uploadedCount} / {soUpload>/totalRecords} 条记录"
                                class="sapUiTinyMarginTop"/>
                        </VBox>
                    </VBox>
                </content>
            </Panel>

            <!-- Upload Results -->
            <Panel
                id="uploadResultsPanel"
                expandable="true"
                expanded="true"
                headerText="上传结果"
                visible="{= ${soUpload>/uploadResults} !== undefined &amp;&amp; ${soUpload>/uploadResults/length} > 0}"
                width="auto"
                class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar style="Clear">
                        <Title text="上传状态"/>
                        <ToolbarSpacer/>
                        <Button
                            text="导出结果"
                            icon="sap-icon://excel-attachment"
                            press="onExportResults"/>
                        <core:Icon src="sap-icon://message-success" class="sapUiTinyMarginEnd"/>
                    </Toolbar>
                </headerToolbar>
                <content>
                    <VBox class="sapUiSmallMargin">
                        <MessageStrip
                            text="{soUpload>/uploadSummaryMessage}"
                            type="{soUpload>/uploadSummaryType}"
                            showIcon="true"
                            class="sapUiSmallMarginBottom"/>
                        
                        <Table
                            id="uploadResultsTable"
                            items="{soUpload>/uploadResults}"
                            growing="true"
                            growingThreshold="20">
                            <columns>
                                <Column width="60px"><Text text="行号"/></Column>
                                <Column width="110px"><Text text="采购订单号"/></Column>
                                <Column width="110px"><Text text="销售订单号"/></Column>
                                <Column width="110px"><Text text="创建日期"/></Column>
                                <Column width="120px"><Text text="上传状态"/></Column>
                                <Column><Text text="消息"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{soUpload>rowIndex}"/>
                                        <Text text="{soUpload>poNumber}"/>
                                        <Text text="{soUpload>soNumber}"/>
                                        <Text text="{soUpload>createdDate}"/>
                                        <ObjectStatus
                                            text="{= ${soUpload>status} === 'Success' ? '成功' : '失败'}"
                                            state="{= ${soUpload>status} === 'Success' ? 'Success' : 'Error'}"
                                            icon="{= ${soUpload>status} === 'Success' ? 'sap-icon://message-success' : 'sap-icon://message-error'}"/>
                                        <Text text="{soUpload>message}"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </content>
            </Panel>

            <!-- Email Notification Configuration -->
            <Panel
                expandable="true"
                expanded="true"
                headerText="邮件通知"
                visible="{= ${soUpload>/uploadResults} !== undefined &amp;&amp; ${soUpload>/uploadResults/length} &gt; 0}"
                width="auto"
                class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar style="Clear">
                        <Title text="邮件配置"/>
                        <ToolbarSpacer/>
                        <core:Icon src="sap-icon://email" class="sapUiTinyMarginEnd"/>
                    </Toolbar>
                </headerToolbar>
                <content>
                    <VBox class="sapUiSmallMargin">
                        <!-- Email Configuration Form -->
                        <VBox class="sapUiSmallMarginBottom">
                            <Label text="收件人" required="true" class="sapUiTinyMarginBottom"/>
                            <Input
                                value="{soUpload>/email/recipients}"
                                placeholder="recipents@sap.com"
                                width="100%"
                                editable="false"/>
                        </VBox>

                        <VBox class="sapUiSmallMarginBottom">
                            <Label text="抄送" class="sapUiTinyMarginBottom"/>
                            <Input
                                value="{soUpload>/email/cc}"
                                placeholder="cc@example.com"
                                width="100%"/>
                        </VBox>

                        <VBox class="sapUiSmallMarginBottom">
                            <Label text="主题" required="true" class="sapUiTinyMarginBottom"/>
                            <Input
                                value="{soUpload>/email/subject}"
                                placeholder="销售订单上传结果 - [日期]"
                                width="100%"/>
                        </VBox>

                        <!-- Smart Email Content Preview -->
                        <VBox class="sapUiSmallMarginBottom">
                            <HBox justifyContent="SpaceBetween" alignItems="Center" class="sapUiTinyMarginBottom">
                                <Label text="邮件预览（自动生成）"/>
                                <HBox>
                                    <Button
                                        text="编辑内容"
                                        type="Transparent"
                                        icon="sap-icon://edit"
                                        press="onEditEmailContent"
                                        visible="{= !${soUpload>/email/editMode}}"
                                        tooltip="点击编辑AI生成的邮件内容"
                                        class="sapUiTinyMarginEnd"/>
                                    <Button
                                        text="保存"
                                        type="Emphasized"
                                        icon="sap-icon://save"
                                        press="onSaveEmailContent"
                                        visible="{soUpload>/email/editMode}"
                                        tooltip="保存修改后的邮件内容"/>
                                </HBox>
                            </HBox>
                            
                            <!-- All Success Scenario -->
                            <MessageStrip
                                visible="{= ${soUpload>/successCount} === ${soUpload>/totalUploadCount} &amp;&amp; ${soUpload>/totalUploadCount} &gt; 0}"
                                text="✅ 所有记录上传成功！"
                                type="Success"
                                showIcon="true"
                                class="sapUiSmallMarginBottom"/>

                            <!-- Partial Success Scenario -->
                            <MessageStrip
                                visible="{= ${soUpload>/failedCount} &gt; 0 &amp;&amp; ${soUpload>/failedCount} &lt; ${soUpload>/totalUploadCount}}"
                                text="⚠️ 部分成功 - 部分记录上传失败"
                                type="Warning"
                                showIcon="true"
                                class="sapUiSmallMarginBottom"/>

                            <!-- Complete Failure Scenario -->
                            <MessageStrip
                                visible="{= ${soUpload>/failedCount} === ${soUpload>/totalUploadCount} &amp;&amp; ${soUpload>/totalUploadCount} &gt; 0}"
                                text="❌ 所有记录上传失败"
                                type="Error"
                                showIcon="true"
                                class="sapUiSmallMarginBottom"/>

                            <!-- Email Content with Modified Indicator -->
                            <VBox class="{= ${soUpload>/email/isModified} ? 'emailModifiedBackground' : ''}">
                                <TextArea
                                    value="{soUpload>/email/content}"
                                    rows="10"
                                    width="100%"
                                    editable="{soUpload>/email/editMode}"
                                    class="sapUiSmallMarginBottom"/>
                            </VBox>
                            
                            <!-- Modified Indicator -->
                            <MessageStrip
                                visible="{soUpload>/email/isModified}"
                                text="✏️ 邮件内容已修改"
                                type="Information"
                                showIcon="true"
                                class="sapUiTinyMarginTop sapUiTinyMarginBottom"/>
                            
                            <!-- Edit Mode Info -->
                            <MessageStrip
                                visible="{soUpload>/email/editMode}"
                                text="💡 您现在可以编辑邮件内容。点击'保存'按钮完成编辑。"
                                type="Information"
                                showIcon="true"
                                class="sapUiTinyMarginTop"/>
                        </VBox>

                        <!-- Send Email Button -->
                        <VBox class="sapUiSmallMarginTop">
                            <HBox justifyContent="End">
                                <Button
                                    text="发送邮件"
                                    type="Emphasized"
                                    icon="sap-icon://email"
                                    press="onSendEmail"
                                    enabled="{= ${soUpload>/email/recipients} !== '' &amp;&amp; ${soUpload>/email/subject} !== ''}"/>
                            </HBox>
                            
                            <!-- Email Send Progress -->
                            <VBox 
                                visible="{= ${soUpload>/email/sending} === true}"
                                class="sapUiSmallMarginTop">
                                <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                    <BusyIndicator size="1rem" class="sapUiTinyMarginEnd"/>
                                    <Text text="正在发送邮件..."/>
                                </HBox>
                                <ProgressIndicator
                                    percentValue="{soUpload>/email/sendProgress}"
                                    displayValue="发送中..."
                                    showValue="true"
                                    state="Information"/>
                            </VBox>

                            <!-- Email Send Result -->
                            <MessageStrip
                                visible="{= ${soUpload>/email/sent} === true}"
                                text="✅ 邮件已成功发送至 {soUpload>/email/recipients}"
                                type="Success"
                                showIcon="true"
                                class="sapUiSmallMarginTop"/>
                        </VBox>
                    </VBox>
                </content>
            </Panel>
        </content>

        <footer>
            <Toolbar>
                <ToolbarSpacer/>
                <Button
                    text="下一步：订单回顾与报告"
                    type="Emphasized"
                    icon="sap-icon://navigation-right-arrow"
                    iconDensityAware="false"
                    press="onNavigateToReviewReport"
                    enabled="{= ${soUpload>/uploadResults} !== undefined &amp;&amp; ${soUpload>/uploadResults/length} &gt; 0}"/>
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
