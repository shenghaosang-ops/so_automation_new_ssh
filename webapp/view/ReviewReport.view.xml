<mvc:View
    controllerName="yegeoaiso.controller.ReviewReport"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data">

    <Page
        id="reviewReportPage"
        title="订单回顾与报告 - AI Insights"
        showNavButton="true"
        navButtonPress="onNavBack"
        backgroundDesign="Transparent">

        <content>
            <!-- AI Analysis Panel -->
            <Panel
                expandable="true"
                expanded="true"
                headerText="AI智能分析"
                width="auto"
                class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar style="Clear">
                        <Title text="AI分析与洞察"/>
                        <ToolbarSpacer/>
                        <Button
                            text="分析数据"
                            icon="sap-icon://lab"
                            type="Emphasized"
                            press="onAnalyzeData"/>
                        <core:Icon src="sap-icon://business-objects-experience" color="#0854a0" class="sapUiTinyMarginEnd"/>
                    </Toolbar>
                </headerToolbar>
                <content>
                    <VBox class="sapUiSmallMargin">
                        <!-- Analysis Progress -->
                        <VBox visible="{= ${report>/aiAnalyzing} === true}" class="sapUiSmallMarginBottom">
                            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                <BusyIndicator size="1rem" class="sapUiTinyMarginEnd"/>
                                <Text text="🤖 AI正在分析您的销售订单数据..." class="sapUiSmallMarginBegin"/>
                            </HBox>
                            <ProgressIndicator
                                percentValue="{report>/aiProgress}"
                                displayValue="分析中..."
                                showValue="true"
                                state="Information"/>
                        </VBox>

                        <!-- AI Analysis Results -->
                        <VBox visible="{= ${report>/aiAnalysisComplete} === true}">
                            <!-- Overall Summary Cards -->
                            <l:Grid defaultSpan="L4 M6 S12" class="sapUiSmallMarginBottom">
                                <l:content>
                                    <!-- Success Rate Card -->
                                    <GenericTile
                                        header="成功率"
                                        subheader="整体表现"
                                        frameType="TwoByOne">
                                        <tileContent>
                                            <TileContent>
                                                <content>
                                                    <NumericContent
                                                        value="{report>/aiAnalysis/successRate}"
                                                        scale="%"
                                                        valueColor="{= ${report>/aiAnalysis/successRate} >= 80 ? 'Good' : ${report>/aiAnalysis/successRate} >= 50 ? 'Critical' : 'Error'}"
                                                        icon="sap-icon://arobase"
                                                        iconDensityAware="false"/>
                                                </content>
                                            </TileContent>
                                        </tileContent>
                                    </GenericTile>

                                    <!-- Total Orders Card -->
                                    <GenericTile
                                        header="订单总数"
                                        subheader="本批次处理"
                                        frameType="TwoByOne">
                                        <tileContent>
                                            <TileContent>
                                                <content>
                                                    <NumericContent
                                                        value="{report>/totalCount}"
                                                        icon="sap-icon://sales-order"
                                                        iconDensityAware="false"/>
                                                </content>
                                            </TileContent>
                                        </tileContent>
                                    </GenericTile>

                                    <!-- Failed Orders Card -->
                                    <GenericTile
                                        header="失败订单"
                                        subheader="点击查看详情"
                                        frameType="TwoByOne"
                                        press="onShowFailedOrders">
                                        <tileContent>
                                            <TileContent>
                                                <content>
                                                    <NumericContent
                                                        value="{report>/failedCount}"
                                                        scale="/ {report>/totalCount}"
                                                        valueColor="Error"
                                                        iconDensityAware="false"/>
                                                </content>
                                            </TileContent>
                                        </tileContent>
                                    </GenericTile>
                                </l:content>
                            </l:Grid>

                            <!-- AI Insights - Hidden by default, shown on Failed Orders click -->
                            <VBox visible="false" class="sapUiSmallMarginTop">
                                <Title text="💡 AI洞察与建议" level="H4" class="sapUiSmallMarginBottom"/>
                            </VBox>
                        </VBox>

                        <!-- No Data Message -->
                        <MessageStrip
                            visible="{= ${report>/aiAnalysisComplete} !== true &amp;&amp; ${report>/aiAnalyzing} !== true}"
                            text="点击'分析数据'获取销售订单创建结果的AI智能洞察"
                            type="Information"
                            showIcon="true"/>
                    </VBox>
                </content>
            </Panel>

            <!-- Failed Orders Details Section (Expandable) -->
            <Panel
                id="failedOrdersSection"
                expandable="true"
                expanded="{report>/showFailedDetails}"
                headerText="失败订单分析"
                width="auto"
                visible="{= ${report>/failedCount} > 0}"
                class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar style="Clear">
                        <Title text="失败订单分析"/>
                        <ToolbarSpacer/>
                        <Button
                            text="导出到Excel"
                            icon="sap-icon://excel-attachment"
                            press="onExportFailedOrders"
                            type="Transparent"/>
                        <core:Icon src="sap-icon://warning" color="#E78C07" class="sapUiTinyMarginBegin"/>
                    </Toolbar>
                </headerToolbar>
                <content>
                    <VBox class="sapUiSmallMargin">
                        <VBox class="sapUiSmallMarginBottom">
                            <MessageStrip
                                text="{= '失败订单总数：' + ${report>/failedCount} + ' / ' + ${report>/totalCount} + '（ERP上传失败：' + ${report>/erpFailedCount} + '，Validation失败：' + ${report>/validationFailedCount} + '）'}"
                                type="Error"
                                showIcon="true"/>
                            <MessageStrip
                                text="ℹ️ ERP Upload Failed: Orders that passed validation but failed during ERP upload. Validation Failed: Orders that did not pass business rules check and were not uploaded."
                                type="Information"
                                showIcon="false"
                                class="sapUiTinyMarginTop"/>
                        </VBox>
                        
                        <Table
                            id="failedOrdersTable"
                            items="{report>/failedOrders}"
                            growing="true"
                            growingThreshold="20"
                            sticky="ColumnHeaders">
                            <columns>
                                <Column width="60px"><Text text="行号"/></Column>
                                <Column width="130px"><Text text="失败类型"/></Column>
                                <Column width="120px"><Text text="采购订单号"/></Column>
                                <Column width="140px"><Text text="客户"/></Column>
                                <Column width="120px"><Text text="物料编号"/></Column>
                                <Column width="70px"><Text text="数量"/></Column>
                                <Column minWidth="200px"><Text text="错误原因"/></Column>
                                <Column minWidth="250px"><Text text="AI建议"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{report>rowIndex}"/>
                                        <ObjectStatus
                                            text="{report>failureType}"
                                            state="{report>failureTypeState}"/>
                                        <Text text="{report>poNumber}"/>
                                        <Text text="{report>customerName}"/>
                                        <Text text="{report>partNumber}"/>
                                        <Text text="{report>quantity}"/>
                                        <VBox>
                                            <HBox alignItems="Center">
                                                <core:Icon src="sap-icon://error" color="#BB0000" size="1rem" class="sapUiTinyMarginEnd"/>
                                                <Text text="{report>errorMessage}" class="sapUiSmallMarginEnd"/>
                                            </HBox>
                                        </VBox>
                                        <VBox>
                                            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
                                                <core:Icon src="sap-icon://lightbulb" color="#0854a0" size="1rem" class="sapUiTinyMarginEnd"/>
                                                <Text text="{report>recommendation}" class="sapUiSmallMarginEnd"/>
                                            </HBox>
                                            <Link
                                                text="返回workzone进行修改"
                                                href="http://localhost:8080/test/flp.html?sap-ui-xx-viewCache=false#Shell-home"
                                                target="_blank"
                                                emphasized="true"/>
                                        </VBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </content>
            </Panel>
        </content>

        <footer>
            <Toolbar>
                <ToolbarSpacer/>
                <Button
                    text="返回主页"
                    icon="sap-icon://home"
                    press="onNavigateToHome"/>
                <Button
                    text="完成工作流"
                    type="Success"
                    icon="sap-icon://accept"
                    press="onCompleteWorkflow"/>
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
