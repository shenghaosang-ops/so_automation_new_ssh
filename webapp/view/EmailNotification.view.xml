<mvc:View
    controllerName="yegeoaiso.controller.EmailNotification"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">

    <Page
        id="emailNotificationPage"
        title="Email Notification"
        showNavButton="true"
        navButtonPress="onNavBack"
        backgroundDesign="Transparent">

        <content>
            <!-- Email Configuration -->
            <Panel
                expandable="true"
                expanded="true"
                headerText="Email Configuration"
                width="auto"
                class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar style="Clear">
                        <Title text="Configure Email Settings"/>
                        <ToolbarSpacer/>
                        <core:Icon src="sap-icon://email" class="sapUiTinyMarginEnd"/>
                    </Toolbar>
                </headerToolbar>
                <content>
                    <form:SimpleForm
                        editable="true"
                        layout="ResponsiveGridLayout"
                        labelSpanXL="3"
                        labelSpanL="3"
                        labelSpanM="3"
                        labelSpanS="12"
                        class="sapUiSmallMargin">
                        <form:content>
                            <!-- Email Recipients -->
                            <Label text="To (Recipients)" required="true"/>
                            <Input
                                value="{email>/recipients}"
                                placeholder="email1@example.com; email2@example.com"
                                width="100%"/>

                            <Label text="CC"/>
                            <Input
                                value="{email>/cc}"
                                placeholder="Optional: CC recipients"
                                width="100%"/>

                            <Label text="Email Subject" required="true"/>
                            <Input
                                value="{email>/subject}"
                                placeholder="SO Upload Results - {date}"
                                width="100%"/>
                        </form:content>
                    </form:SimpleForm>
                </content>
            </Panel>

            <!-- Smart Email Content Preview -->
            <Panel
                expandable="true"
                expanded="true"
                headerText="Email Content Preview"
                width="auto"
                class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar style="Clear">
                        <Title text="Auto-Generated Email Content"/>
                        <ToolbarSpacer/>
                        <Text text="{email>/emailContentType}" class="sapUiTinyMarginEnd"/>
                        <core:Icon src="sap-icon://message-information" class="sapUiTinyMarginEnd"/>
                    </Toolbar>
                </headerToolbar>
                <content>
                    <VBox class="sapUiSmallMargin">
                        <!-- Success Scenario -->
                        <MessageStrip
                            visible="{= ${email>/successCount} === ${email>/totalCount} &amp;&amp; ${email>/totalCount} &gt; 0}"
                            text="🎉 All records uploaded successfully!"
                            type="Success"
                            showIcon="true"
                            class="sapUiSmallMarginBottom"/>

                        <!-- Partial Success Scenario -->
                        <MessageStrip
                            visible="{= ${email>/failedCount} &gt; 0 &amp;&amp; ${email>/failedCount} &lt; ${email>/totalCount}}"
                            text="⚠️ Partial success - Some records failed to upload"
                            type="Warning"
                            showIcon="true"
                            class="sapUiSmallMarginBottom"/>

                        <!-- Complete Failure Scenario -->
                        <MessageStrip
                            visible="{= ${email>/failedCount} === ${email>/totalCount} &amp;&amp; ${email>/totalCount} &gt; 0}"
                            text="❌ All records failed to upload"
                            type="Error"
                            showIcon="true"
                            class="sapUiSmallMarginBottom"/>

                        <!-- Email Content -->
                        <TextArea
                            value="{email>/emailContent}"
                            rows="15"
                            editable="false"
                            width="100%"/>
                    </VBox>
                </content>
            </Panel>

            <!-- Failed Records Details (Only shown when there are failures) -->
            <Panel
                expandable="true"
                expanded="true"
                headerText="Failed Records Details"
                visible="{= ${email>/failedCount} &gt; 0}"
                width="auto"
                class="sapUiNoContentPadding">
                <headerToolbar>
                    <Toolbar style="Clear">
                        <Title text="Records that Failed to Upload"/>
                        <ToolbarSpacer/>
                        <Text text="Failed: {email>/failedCount} of {email>/totalCount}"/>
                        <ToolbarSpacer width="1rem"/>
                        <core:Icon src="sap-icon://warning" color="#E9730C" class="sapUiTinyMarginEnd"/>
                    </Toolbar>
                </headerToolbar>
                <content>
                    <VBox class="sapUiSmallMargin">
                        <Table
                            id="failedRecordsTable"
                            items="{
                                path: 'email>/emailData',
                                filters: [{
                                    path: 'status',
                                    operator: 'NE',
                                    value1: 'Success'
                                }]
                            }"
                            sticky="ColumnHeaders">
                            <columns>
                                <Column width="60px"><Text text="Row #"/></Column>
                                <Column><Text text="PO Number"/></Column>
                                <Column><Text text="Customer Code"/></Column>
                                <Column><Text text="Part No"/></Column>
                                <Column><Text text="Quantity"/></Column>
                                <Column width="250px"><Text text="Error Reason"/></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{email>rowIndex}"/>
                                        <Text text="{email>poNumber}"/>
                                        <Text text="{email>customerCode}"/>
                                        <Text text="{email>partNo}"/>
                                        <Text text="{email>quantity}"/>
                                        <Text text="{email>message}"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                </content>
            </Panel>

            <!-- Send Email Section -->
            <Panel
                expandable="false"
                expanded="true"
                headerText="Send Email"
                width="auto"
                class="sapUiNoContentPadding">
                <content>
                    <VBox class="sapUiSmallMargin">
                        <HBox justifyContent="SpaceBetween" alignItems="Center">
                            <VBox width="60%">
                                <MessageStrip
                                    text="Review the email content above and click Send to notify stakeholders."
                                    type="Information"
                                    showIcon="true"/>
                            </VBox>
                            <VBox width="35%">
                                <Button
                                    text="Send Email"
                                    type="Emphasized"
                                    icon="sap-icon://paper-plane"
                                    press="onSendEmail"
                                    width="100%"/>
                            </VBox>
                        </HBox>
                        
                        <!-- Send Progress -->
                        <VBox 
                            visible="{= ${email>/sendInProgress} === true}"
                            class="sapUiSmallMarginTop">
                            <Label text="Sending Email..." class="sapUiTinyMarginBottom"/>
                            <ProgressIndicator
                                percentValue="{email>/sendProgress}"
                                displayValue="Processing..."
                                showValue="true"
                                state="Information"/>
                        </VBox>

                        <!-- Send Result -->
                        <MessageStrip
                            visible="{= ${email>/sendResult} !== ''}"
                            text="{email>/sendResultMessage}"
                            type="{email>/sendResultType}"
                            showIcon="true"
                            class="sapUiSmallMarginTop"/>
                    </VBox>
                </content>
            </Panel>
        </content>

        <footer>
            <Toolbar>
                <ToolbarSpacer/>
                <Button
                    text="Next: Review &amp; Report"
                    type="Emphasized"
                    icon="sap-icon://navigation-right-arrow"
                    iconDensityAware="false"
                    press="onNavigateToReviewReport"
                    enabled="{= ${email>/sendResult} === 'success'}"/>
            </Toolbar>
        </footer>
    </Page>
</mvc:View>
