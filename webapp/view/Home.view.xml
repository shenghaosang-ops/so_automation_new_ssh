<mvc:View
    controllerName="yegeoaiso.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core">

    <Page
        id="homePage"
        title="销售订单自动化代理"
        showNavButton="false"
        backgroundDesign="Transparent">

        <content>
            <l:VerticalLayout width="100%" class="sapUiSmallMarginTop">
                <!-- Welcome Section -->
                <VBox alignItems="Center" class="sapUiSmallMarginBottom">
                    <Title text="欢迎使用销售订单自动化代理" level="H2" class="sapUiTinyMarginBottom"/>
                    <Text text="端到端销售订单创建解决方案"/>
                </VBox>

                <!-- Process Flow Cards - 2x2 Grid Layout (Compact) -->
                <VBox alignItems="Center">
                    <!-- First Row -->
                    <HBox justifyContent="Center" class="sapUiSmallMarginBottom">
                        <!-- Data Acquisition -->
                        <VBox alignItems="Center" width="360px" class="sapUiMediumMargin">
                            <core:Icon src="sap-icon://database" size="4rem" color="#0854a0" 
                                      class="sapUiSmallMarginBottom"/>
                            <Title text="1. 数据获取" level="H3" 
                                   class="sapUiTinyMarginBottom" textAlign="Center"/>
                            <Text text="使用OCR和自动化技术从网页或PDF文档中提取数据" 
                                  textAlign="Center" class="sapUiTinyMarginBottom"/>
                            <Button text="开始" type="Emphasized" 
                                    press="onNavigateToDataAcquisition" width="120px"/>
                        </VBox>

                        <!-- SO Automation -->
                        <VBox alignItems="Center" width="360px" class="sapUiMediumMargin">
                            <core:Icon src="sap-icon://flight" size="4rem" color="#0854a0" 
                                      class="sapUiSmallMarginBottom"/>
                            <Title text="2. 销售订单自动化" level="H3" 
                                   class="sapUiTinyMarginBottom" textAlign="Center"/>
                            <Text text="上传Excel数据并使用AI驱动的自动化处理销售订单" 
                                  textAlign="Center" class="sapUiTinyMarginBottom"/>
                            <Button text="开始" type="Default" 
                                    press="onNavigateToSOAutomation" width="120px"/>
                        </VBox>
                    </HBox>

                    <!-- Second Row -->
                    <HBox justifyContent="Center" class="sapUiSmallMarginTop">
                        <!-- SO Upload -->
                        <VBox alignItems="Center" width="360px" class="sapUiMediumMargin">
                            <core:Icon src="sap-icon://upload-to-cloud" size="4rem" color="#0854a0" 
                                      class="sapUiSmallMarginBottom"/>
                            <Title text="3. 销售订单上传" level="H3" 
                                   class="sapUiTinyMarginBottom" textAlign="Center"/>
                            <Text text="校验并上传销售订单至SAP系统，实时状态跟踪" 
                                  textAlign="Center" class="sapUiTinyMarginBottom"/>
                            <Button text="开始" type="Default" 
                                    press="onNavigateToSOUpload" width="120px"/>
                        </VBox>

                        <!-- Review & Report -->
                        <VBox alignItems="Center" width="360px" class="sapUiMediumMargin">
                            <core:Icon src="sap-icon://business-objects-experience" size="4rem" color="#0854a0" 
                                      class="sapUiSmallMarginBottom"/>
                            <Title text="4. 订单回顾与报告" level="H3" 
                                   class="sapUiTinyMarginBottom" textAlign="Center"/>
                            <Text text="AI智能分析洞察及综合报告功能" 
                                  textAlign="Center" class="sapUiTinyMarginBottom"/>
                            <Button text="开始" type="Default" 
                                    press="onNavigateToReviewReport" width="120px"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Process Flow Indicator -->
                <VBox alignItems="Center" class="sapUiMediumMarginTop">
                    <Text text="流程步骤：" class="sapUiTinyMarginBottom" />
                    <HBox alignItems="Center">
                        <core:Icon src="sap-icon://database" size="2rem" color="#0854a0" class="sapUiTinyMarginEnd"/>
                        <core:Icon src="sap-icon://navigation-right-arrow" size="1rem" color="#0854a0" class="sapUiTinyMarginEnd"/>
                        <core:Icon src="sap-icon://flight" size="2rem" color="#0854a0" class="sapUiTinyMarginEnd"/>
                        <core:Icon src="sap-icon://navigation-right-arrow" size="1rem" color="#0854a0" class="sapUiTinyMarginEnd"/>
                        <core:Icon src="sap-icon://upload-to-cloud" size="2rem" color="#0854a0" class="sapUiTinyMarginEnd"/>
                        <core:Icon src="sap-icon://navigation-right-arrow" size="1rem" color="#0854a0" class="sapUiTinyMarginEnd"/>
                        <core:Icon src="sap-icon://business-objects-experience" size="2rem" color="#0854a0"/>
                    </HBox>
                </VBox>
            </l:VerticalLayout>
        </content>
    </Page>
</mvc:View>
