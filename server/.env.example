# Environment Variables for Email Server

# SMTP Configuration (from BPA Destination)
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=867749660@qq.com
SMTP_PASSWORD=your_qq_email_authorization_code_here
SMTP_FROM=867749660@qq.com

# Server Configuration
PORT=3000
NODE_ENV=development

# Optional Behavior Flags
SKIP_SMTP_VERIFY=true
EMAIL_TIMEOUT=8000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:4004

# Email Settings
MAX_RECIPIENTS=10
